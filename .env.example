# Server
NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/aurelia
# Or individual:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=aurelia
# DB_USER=user
# DB_PASSWORD=password

# Supabase (optional - if using Supabase as Postgres host)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Security
SESSION_SECRET=change-this-to-a-long-random-string-in-production-min-32-chars
CORS_ORIGIN=http://localhost:3000

# Admin bootstrap (used only on first seed if no admin exists)
ADMIN_EMAIL=admin@aurelia.example
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Administrador

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
CONTACT_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_MAX=10
